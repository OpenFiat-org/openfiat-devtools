# openfiat-node has no config file of its own — every setting is an
# environment variable, read once at startup (see openfiat-core's
# crates/cli). This is the bootstrap node for the public testnet: no
# CLI_BOOTSTRAP_PEERS of its own, since everyone else dials in to it.

CLI_DATA_DIR=/data
CLI_WALLET_PATH=/data/wallet.json
CLI_HTTP_ADDR=0.0.0.0:8080
CLI_LISTEN_ADDR=/ip4/0.0.0.0/udp/4001/quic-v1

# Unset: stays GossipOnly. Set to a devnet RPC URL for RpcConnected
# behavior (OFS-4300 §4) — never commit a real endpoint/API key here.
#CLI_SOLANA_RPC_URLS=
